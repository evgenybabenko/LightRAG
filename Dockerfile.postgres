FROM pgvector/pgvector:0.8.2-pg16-bookworm AS build

ARG AGE_GIT_REF=PG16/v1.6.0-rc0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bison \
        build-essential \
        ca-certificates \
        flex \
        git \
        libreadline-dev \
        postgresql-server-dev-16 \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${AGE_GIT_REF}" https://github.com/apache/age.git /tmp/age \
    && make -C /tmp/age install \
    && rm -rf /tmp/age

FROM pgvector/pgvector:0.8.2-pg16-bookworm

COPY --from=build /usr/lib/postgresql/16/lib/age.so /usr/lib/postgresql/16/lib/
COPY --from=build /usr/share/postgresql/16/extension/age* /usr/share/postgresql/16/extension/
COPY docker/postgres/initdb/00-create-extensions.sql /docker-entrypoint-initdb.d/00-create-extensions.sql

CMD ["postgres", "-c", "shared_preload_libraries=age"]
