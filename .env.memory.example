### Common settings for docker-compose.memory.yml
### Copy to .env.memory and replace placeholders before running the memory stack.

POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=replace-with-admin-password
POSTGRES_DB=postgres

### Compose port binding. For Synology, keep Postgres private and expose only
### the two API ports through LAN/VPN/reverse proxy.
MEMORY_POSTGRES_BIND=127.0.0.1
MEMORY_POSTGRES_PORT=54330
MEMORY_PERSONAL_BIND=127.0.0.1
MEMORY_PERSONAL_PORT=9631
MEMORY_LIMBAL_BIND=127.0.0.1
MEMORY_LIMBAL_PORT=9632

### Synology compose uses prebuilt images instead of building the full repo on NAS.
LIGHTRAG_MEMORY_IMAGE=ghcr.io/evgenybabenko/lightrag-memory:replace-with-tag
LIGHTRAG_POSTGRES_IMAGE=ghcr.io/evgenybabenko/lightrag-postgres-age:replace-with-tag

MEMORY_POSTGRES_ADMIN_USER=rag_admin
MEMORY_POSTGRES_ADMIN_PASSWORD=replace-with-admin-password
MEMORY_POSTGRES_ADMIN_DATABASE=postgres

### Shared LLM / embedding / reranker settings used by memory LightRAG APIs.
LLM_BINDING=openai
LLM_BINDING_HOST=http://host.docker.internal:6002/v1
LLM_BINDING_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-5.4-mini
OPENAI_USE_RESPONSES_API=True

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://foundation-models.api.cloud.ru/v1
EMBEDDING_BINDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

RERANK_BINDING=cloudru
RERANK_BINDING_HOST=https://foundation-models.api.cloud.ru/score
RERANK_BINDING_API_KEY=replace-with-rerank-api-key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BY_DEFAULT=False

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
POSTGRES_MAX_CONNECTIONS=25

TOKEN_EXPIRE_HOURS=24
GUEST_TOKEN_EXPIRE_HOURS=2
TOKEN_AUTO_RENEW=True
WHITELIST_PATHS=/health
