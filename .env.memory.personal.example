### Personal memory service settings.
### Copy to .env.memory.personal and replace secrets.

POSTGRES_DATABASE=rag_personal
POSTGRES_USER=rag_personal
POSTGRES_PASSWORD=replace-with-personal-db-password

MEMORY_PERSONAL_DATABASE=rag_personal
MEMORY_PERSONAL_USER=rag_personal
MEMORY_PERSONAL_PASSWORD=replace-with-personal-db-password

### Docker Compose v2 may interpolate bcrypt dollar signs in env files.
### If that happens, escape $ as $$ for Compose v2. Synology docker-compose v1
### passes this file literally, so keep raw bcrypt there.
AUTH_ACCOUNTS=personal:{bcrypt}replace-with-generated-hash
TOKEN_SECRET=replace-with-personal-token-secret
LIGHTRAG_API_KEY=replace-with-personal-api-key
WEBUI_DESCRIPTION=Private Codex personal decision memory
