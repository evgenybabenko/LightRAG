# Shared CloudPub edge for Synology.
# Copy to /volume1/docker/edge/.env.edge on the NAS and fill the token there.

# For ARM Synology hosts use cloudpub/cloudpub:latest-arm64.
EDGE_CLOUDPUB_IMAGE=cloudpub/cloudpub:latest
EDGE_CLOUDPUB_TOKEN=replace-with-cloudpub-api-token
EDGE_CLOUDPUB_CONFIG_HOST_DIR=/volume1/docker/edge/cloudpub

# Compatibility host used by the existing Limbal CloudPub resource
# `http://app:2455`. The Limbal public gateway binds host port 2455.
EDGE_LIMBAL_COMPAT_HOST=192.168.1.160
