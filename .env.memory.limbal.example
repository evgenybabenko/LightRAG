### Limbal shared project memory service settings.
### Copy to .env.memory.limbal and replace secrets.

POSTGRES_DATABASE=rag_project_limbal
POSTGRES_USER=rag_project_limbal
POSTGRES_PASSWORD=replace-with-limbal-db-password

MEMORY_LIMBAL_DATABASE=rag_project_limbal
MEMORY_LIMBAL_USER=rag_project_limbal
MEMORY_LIMBAL_PASSWORD=replace-with-limbal-db-password

### Docker Compose v2 may interpolate bcrypt dollar signs in env files.
### If that happens, escape $ as $$ for Compose v2. Synology docker-compose v1
### passes this file literally, so keep raw bcrypt there.
AUTH_ACCOUNTS=limbal:{bcrypt}replace-with-generated-hash
TOKEN_SECRET=replace-with-limbal-token-secret
LIGHTRAG_API_KEY=replace-with-limbal-api-key
WEBUI_DESCRIPTION=Shared Limbal project decision memory
